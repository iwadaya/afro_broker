# Copy to .env and adjust.
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/broking_dev
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/broking_test
# Enable TLS to the database (required by most managed providers).
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Auth. In production JWT_SECRET is mandatory and must be >= 32 chars —
# the app refuses to boot otherwise. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=12h

# Comma-separated browser origins allowed to call the API. Leave empty for a
# single-origin deployment (the API serves the SPA itself). Development allows
# any origin so the Vite dev server on :5173 can reach the API.
CORS_ORIGINS=

# Serve the built frontend (frontend/dist) from this process. Defaults to on in
# production, off otherwise.
SERVE_STATIC=
STATIC_DIR=

# Trust the X-Forwarded-* headers of a reverse proxy. Defaults to on in
# production. Required for correct client IPs (and thus rate limiting) on a PaaS.
TRUST_PROXY=

# Login rate limiting. Only FAILED sign-ins count toward the limit.
RATE_LIMIT_ENABLED=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_LOGIN_FAILURES=10

# Apply pending migrations at boot. Turn off where a release/pre-deploy phase
# runs `npm run migrate` instead.
MIGRATE_ON_BOOT=true

# Load the wording library (standard clause corpus, reinsurer house wordings and
# the LMA/Institute/BRMA market forms) on the first boot of a database. Defaults
# to on: migrations create the tables but carry no clauses, and a platform with
# no shell cannot run `npm run seed`. It fires once per database — clear the
# library to load your own approved wordings and it stays cleared.
SEED_WORDING_LIBRARY_ON_BOOT=true

# Demo sign-in. With this set, every user's password is reset to it at boot
# and the login screen offers a dropdown of users with it filled in. For
# demonstrations only — clear it (and change the passwords) for real use.
DEMO_PASSWORD=demo2026

# Demo auto sign-in. With this set, opening the app signs the visitor in as
# this user with no login screen (Sign out still shows it, with a "Continue
# as" button). An email, or 1 for the first demo user (a broker). Anyone with
# the URL gets that user's session — demonstrations only; leave empty otherwise.
DEMO_AUTO_LOGIN=

# First-run admin, for platforms with no shell access. Only applied when the
# users table is empty; clear these once you have signed in. Min 12 chars.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# Universe integration (technical pull). Stubbed by default.
UNIVERSE_API_URL=
UNIVERSE_API_KEY=

# AI features: renewal pack analysis (§02 — reads uploaded packs and compares
# expiring vs current), bordereau analysis, counterparty research on the
# market register, and submission commentary. Everything goes to ChatGPT —
# there is deliberately no fallback provider. Set no key and the computed
# figures still work; only the written commentary is unavailable and the
# register stays manual-entry only. Counterparty research runs ChatGPT's
# server-side web search, and pack uploads ride as native file/image inputs,
# so one key covers every feature. The model id is overridable for pinning.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Submission email. Leave MAIL_TRANSPORT empty and the send goes out through
# the connected Outlook mailbox when there is one (below), else SMTP_URL, else
# `stub` — which records messages in-process and delivers nothing. Set it to
# force one of `outlook`, `smtp` (needs the optional `nodemailer`) or `stub`.
MAIL_TRANSPORT=
SMTP_URL=
MAIL_FROM=broking@universe.local
MAIL_REPLY_TO=

# Outlook (Microsoft Graph): the mailbox submissions are sent from and whose
# inbox is read for the underwriters' replies. Register an app on the Azure
# portal (Entra ID → App registrations → New): "Accounts in any organizational
# directory and personal Microsoft accounts", a Web redirect URI equal to
# MS_REDIRECT_URI below, a client secret, and delegated Microsoft Graph
# permissions offline_access, User.Read, Mail.Send, Mail.ReadWrite. Then
# connect the mailbox from the Admin page — it signs in with Microsoft, and
# the tokens are kept and refreshed server-side. MS_TENANT: `common` takes a
# personal Outlook.com / Hotmail address or a work account; `consumers`
# personal only; or a tenant id for one organisation.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
MS_REDIRECT_URI=http://localhost:4000/api/outlook/callback
# Where the browser lands after the Microsoft sign-in (the SPA). Defaults to
# the Vite dev server in development and the API's own origin in production.
APP_URL=
# How often the inbox is read for replies (ms). Default five minutes.
MAIL_SYNC_INTERVAL_MS=300000
