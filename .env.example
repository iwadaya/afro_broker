# AABI broking — environment template. Copy to .env (never commit the copy).
# The server loads .env from the repo root, server/, and the working directory.

NODE_ENV=development
PORT=4000

# PostgreSQL 16 connection string (matches docker-compose and scripts/test-db.sh).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/afro_broker

# Apply pending migrations on boot. deploy/deploy.sh runs them explicitly before
# the restart, so production keeps this false.
RUN_MIGRATIONS_ON_BOOT=false

# Comma-separated allowed browser origins; '*' reflects the request origin (dev only).
CORS_ORIGIN=*

# ── Broking module ───────────────────────────────────────────────────────────
# Feature flag: the /api/broking routes are mounted and the module appears in
# navigation only when this is exactly 'true'. Default OFF.
BROKING_ENABLED=true
# The broking house's 4-digit Lloyd's broker number. Pre-fills every new UMR as
# 'B' + this number on the Identify step. Leave unset to pre-fill just 'B'.
BROKING_LLOYDS_BROKER_NO=0621

# ── Auth ─────────────────────────────────────────────────────────────────────
# HMAC secret for the httpOnly auth cookie token. REQUIRED in production
# (>= 32 chars); dev/test mint a per-process ephemeral secret when unset.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# AUTH_JWT_SECRET=
# Optional CSRF signing secret (falls back to AUTH_JWT_SECRET).
# SESSION_SECRET=
# Session lifetime in hours (default 8).
SESSION_TTL_HOURS=8
# Dev/test only: enables the universal demo password ('demo2026') and the
# x-user-id header identity the integration tests use. NEVER set in production.
ALLOW_DEMO_AUTH=true
